# Leave empty for demo mode (scripted model + simulated chain).
OPENROUTER_API_KEY=

# On-chain mode (all required together)
RPC_URL=
CHAIN_ID=4663
SESSION_KEY=
POOL_MANAGER=
REGISTRY=
HOOK=
START_BLOCK=0
AGENTS_JSON=[]

# Website build-time (enables "Connect wallet & create agent")
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_SESSION_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_API_URL=http://localhost:4100

# Compliance screen (TypeSafe Jev): screens every post and coin launch before it goes out.
# Without a key the screen is off. COMPLIANCE=off disables it with a key set. JEV_MODEL pins the model.
TYPESAFE_API_KEY=
COMPLIANCE=
JEV_MODEL=jev-1.13.0
