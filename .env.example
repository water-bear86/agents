# Leave empty for demo mode (scripted model + simulated chain).
OPENROUTER_API_KEY=

# On-chain mode (all required together)
RPC_URL=
CHAIN_ID=4663
SESSION_KEY=
POOL_MANAGER=
REGISTRY=
HOOK=
START_BLOCK=0
AGENTS_JSON=[]

# Solana (see docs/SOLANA-PORT.md). CHAIN_FAMILY=solana alone runs the demo in SOL with 6-decimal
# coins. For on-chain mode add SOLANA_RPC_URL and SOLANA_SESSION_KEYPAIR (the keypair file of the
# session key agents were created with); the DBC config is read from the agents program. AGENTS_JSON
# entries need only {"handle","persona","style"}. Mainnet is refused unless SOLANA_ALLOW_MAINNET=1.
# SOLANA_PUBLIC_RPC_URL is what the website's wallet flow uses (never put a keyed RPC URL there).
CHAIN_FAMILY=
SOLANA_RPC_URL=
SOLANA_SESSION_KEYPAIR=
SOLANA_PUBLIC_RPC_URL=
COIN_URI_BASE=

# Paper trading the live Solana market (with CHAIN_FAMILY=solana, no session key): agents trade
# real mainnet tokens at live prices with simulated fills; nothing is signed or sent. SOLANA_RPC_URL
# is the mainnet RPC used to check each token's mint (a keyed RPC is fine, it never reaches the browser).
PAPER=
PAPER_TOKENS=12
PAPER_MIN_LIQUIDITY_USD=50000

# StonkFun (paper mode): its busy coins join the market and agents launch there on a simulated curve.
# STONKFUN=0 turns it off. STONKFUN_TOKENS caps how many StonkFun coins join; STONKFUN_MIN_LIQUIDITY_USD sets the floor.
# STONKFUN=1
# STONKFUN_TOKENS=8
# STONKFUN_MIN_LIQUIDITY_USD=5000

# Website build-time (enables "Connect wallet & create agent")
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_SESSION_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_API_URL=http://localhost:4100

# Compliance screen (TypeSafe Jev): screens every post and coin launch before it goes out.
# Without a key the screen is off. COMPLIANCE=off disables it with a key set. JEV_MODEL pins the model.
TYPESAFE_API_KEY=
COMPLIANCE=
JEV_MODEL=jev-1.13.0
