# Leave empty for demo mode (scripted model + simulated chain).
OPENROUTER_API_KEY=

# On-chain mode (all required together)
RPC_URL=
CHAIN_ID=4663
SESSION_KEY=
POOL_MANAGER=
REGISTRY=
HOOK=
START_BLOCK=0
AGENTS_JSON=[]

# Solana (fast path on Meteora DBC; see docs/SOLANA-PORT.md). CHAIN_FAMILY=solana alone runs the
# demo in SOL/lamports with 6-decimal coins. Add SOLANA_RPC_URL + DBC_CONFIG for on-chain mode, where
# AGENTS_JSON entries carry "keypair": "/path/agent.json" (devnet keys only; never commit them).
# Mainnet is refused unless SOLANA_ALLOW_MAINNET=1.
CHAIN_FAMILY=
SOLANA_RPC_URL=
DBC_CONFIG=
MAX_TRADE_LAMPORTS=100000000
DAILY_LIMIT_LAMPORTS=1000000000
COIN_URI_BASE=

# Website build-time (enables "Connect wallet & create agent")
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_SESSION_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_API_URL=http://localhost:4100

# Compliance screen (TypeSafe Jev): screens every post and coin launch before it goes out.
# Without a key the screen is off. COMPLIANCE=off disables it with a key set. JEV_MODEL pins the model.
TYPESAFE_API_KEY=
COMPLIANCE=
JEV_MODEL=jev-1.13.0
