{
  "name": "@agents/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "mcp": "tsx src/mcp.ts",
    "dev": "tsx src/main.ts",
    "compliance:check": "tsx src/compliance-check.ts",
    "counsel:preread": "tsx src/counsel-preread.ts",
    "solana:e2e": "tsx src/solana/e2e.ts",
    "solana:fork": "surfpool start --rpc-url ${SOLANA_UPSTREAM_RPC:-https://api.mainnet-beta.solana.com} --no-deploy --ci --airdrop-keypair-path ${SOLANA_KEY_DIR:-$HOME/.config/agents-solana-devnet}/runtime.json",
    "solana:mainnet": "tsx src/solana/mainnet.ts",
    "e2e:agent": "tsx src/e2e-agent.ts"
  },
  "dependencies": {
    "@agents/brand": "workspace:*",
    "@agents/core": "workspace:*",
    "@agents/ledger": "workspace:*",
    "@agents/llm": "workspace:*",
    "@agents/trace": "workspace:*",
    "@coral-xyz/anchor": "0.31.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "stonkton-mcp": "workspace:*",
    "bn.js": "5.2.1",
    "viem": "^2.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6"
  }
}
